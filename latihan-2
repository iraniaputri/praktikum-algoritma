# Menentukan jumlah hari dalam bulan
print("=== Program Jumlah Hari dalam Bulan ===")
print("(Ketik 'keluar' pada bulan untuk berhenti)\n")

while True:
    bulan_input = input("Masukkan bulan (1-12) atau 'keluar': ")

    if bulan_input.lower() == "keluar":
        print("Program selesai. Terima kasih!")
        break

    try:
        bulan = int(bulan_input)
        tahun = int(input("Masukkan tahun (contoh: 2024): "))
    except ValueError:
        print("Input tidak valid! Masukkan angka.\n")
        continue

    if bulan < 1 or bulan > 12:
        print("Bulan harus antara 1 - 12!\n")
        continue

    # Daftar bulan dengan 31 hari
    bulan_31 = [1, 3, 5, 7, 8, 10, 12]
    # Daftar bulan dengan 30 hari
    bulan_30 = [4, 6, 9, 11]

    if bulan in bulan_31:
        jumlah_hari = 31
    elif bulan in bulan_30:
        jumlah_hari = 30
    else:
        # Bulan Februari — cek tahun kabisat
        if (tahun % 4 == 0 and tahun % 100 != 0) or (tahun % 400 == 0):
            jumlah_hari = 29
        else:
            jumlah_hari = 28

    nama_bulan = [
        "Januari", "Februari", "Maret", "April", "Mei", "Juni",
        "Juli", "Agustus", "September", "Oktober", "November", "Desember"
    ]

    print(f"Bulan {nama_bulan[bulan - 1]} {tahun} memiliki {jumlah_hari} hari.\n")